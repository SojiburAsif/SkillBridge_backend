// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TutorProfile {
  id         String      @id @default(uuid())
  bio        String      @db.Text
  price      Decimal     @db.Decimal(10, 2)
  rating     Float       @default(0)
  totalReviews Int       @default(0)
  gender     String?
  institution String?
  experience String      @db.Text
  status     TutorStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  categories TutorProfileCategory[]
  tutorSlots TutorSlot[]
  wishlistedBy Wishlist[]
}

model TutorProfileCategory {
  id             String       @id @default(uuid())
  tutorProfileId String
  categoryId     String
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, categoryId])
  @@index([categoryId])
}

model TutorSlot {
  id        String       @id @default(uuid())
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id])
  date      DateTime
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bookings  Booking[]
}

enum TutorStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING
}

model Category {
  id        String         @id @default(uuid())
  name      String
  icon      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now())
  tutors    TutorProfile[]
  tutorProfiles TutorProfileCategory[]
}

model Booking {
  id        String        @id @default(uuid())
  dateTime  DateTime
  status    BookingStatus @default(AWAITING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  originalAmount Float?
  discountAmount Float?
  paidAmount     Float?
  transactionId String?    @unique
  videoCallId   String?    @unique
  isAutoCompleted Boolean  @default(false)
  mutualConfirmation Json? @default("{\"tutorConfirmed\": false, \"studentConfirmed\": false}")
  videoSession Json?     @default("{\"sessionUrl\": null, \"isActive\": false, \"expiresAt\": null}")
  createdAt DateTime      @default(now())

  couponId  String?
  coupon    Coupon? @relation(fields: [couponId], references: [id])

  studentId String
  student   User   @relation("StudentBookings", fields: [studentId], references: [id])

  tutorId String
  tutor   User   @relation("TutorBookings", fields: [tutorId], references: [id])

  slotId    String?
  tutorSlot TutorSlot? @relation(fields: [slotId], references: [id])

  review Review?
}

enum BookingStatus {
  AWAITING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
  ATTENDED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUND_REQUESTED
  REFUND_PROCESSED
  FAILED
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String   @db.Text
  isVerified Boolean @default(true)
  createdAt DateTime @default(now())

  // Relations
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  studentId String
  student   User   @relation("StudentReviews", fields: [studentId], references: [id])

  tutorId String
  tutor   User   @relation("TutorReviews", fields: [tutorId], references: [id])
}

model StudentProfile {
  id          String   @id @default(uuid())
  StudentID   Int      @default(autoincrement())
  grade       String?
  institution String?  
  gender      String?
  interests   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  role          UserRole   @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  tutorProfile    TutorProfile?
  sessions        Session[]
  accounts        Account[]
  notifications   Notification[]
  bookings        Booking[]       @relation("StudentBookings")
  tutorBookings   Booking[]       @relation("TutorBookings")
  reviewsGiven    Review[]        @relation("StudentReviews")
  reviewsReceived Review[]        @relation("TutorReviews")
  wishlistItems   Wishlist[]      @relation("StudentWishlist")
  messagesSent    Message[]       @relation("SentMessages")
  messagesRecv    Message[]       @relation("ReceivedMessages")
  studentProfile  StudentProfile?

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BAND
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String
  isRead        Boolean  @default(false)
  type          String   @default("INFO")
  transactionId String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notifications")
}

model Wishlist {
  id             String   @id @default(uuid())
  studentId      String
  student        User     @relation("StudentWishlist", fields: [studentId], references: [id])
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([studentId, tutorProfileId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  text       String   @db.Text
  createdAt  DateTime @default(now())
  readAt     DateTime?
}


model Coupon {
  id                 String   @id @default(uuid())
  code               String   @unique
  discountPercentage Float
  expireDate         DateTime
  maxUsage           Int
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())

  bookings           Booking[]
}
